# ========================================================
# Fullstack Deployment Environment Variables (.env.example)
# ========================================================

# ── Backend Configuration (FastAPI) ─────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Strict CORS: Whitelist allowed frontend origins (comma-separated):
# The backend will strictly reject requests from any other domain
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Secure Client Secret Key:
# Must match VITE_CLIENT_API_KEY in the frontend so only your frontend app can invoke the API
CLIENT_API_KEY=bbc-nlp-secure-frontend-key-2026

# Optional Custom Model Location (defaults to models/bbc_best_model.pkl)
# MODEL_PATH=models/bbc_best_model.pkl

# ── Frontend Configuration (React 18 + Vite) ────────────
# The public URL of the deployed backend API that the browser calls
VITE_API_URL=https://your-backend-api.onrender.com

# Must match backend's CLIENT_API_KEY
VITE_CLIENT_API_KEY=bbc-nlp-secure-frontend-key-2026
