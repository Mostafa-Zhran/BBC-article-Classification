# ========================================================
# Fullstack Deployment Environment Variables (.env.example)
# ========================================================

# ── Backend Configuration (FastAPI) ─────────────────────
# Host interface and Port for cloud platforms (e.g., Render, Railway, Heroku)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Allowed Origins:
# Use '*' to allow all origins, or comma-separated domains:
# e.g.: CORS_ORIGINS=https://my-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Optional Custom Model Location (defaults to models/bbc_best_model.pkl)
# MODEL_PATH=models/bbc_best_model.pkl

# ── Frontend Configuration (React 18 + Vite) ────────────
# The public URL of the deployed backend API that the user's browser calls
VITE_API_URL=https://your-backend-api.onrender.com
