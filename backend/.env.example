# Backend Environment Template (.env.example)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Whitelist allowed frontend domains (comma-separated):
# Only requests from these origins or with the matching CLIENT_API_KEY will be accepted
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Secure secret key shared strictly between frontend and backend
CLIENT_API_KEY=bbc-nlp-secure-frontend-key-2026

# Optional Custom Model Path
# MODEL_PATH=models/bbc_best_model.pkl
